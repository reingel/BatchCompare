{
  "name": "batch-compare",
  "displayName": "BatchCompare",
  "description": "Compare two folders side by side and diff their files",
  "version": "2.7.0",
  "publisher": "reingel",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "batchCompare.compareFiles",
        "title": "Batch Compare: Files"
      },
      {
        "command": "batchCompare.compare",
        "title": "Batch Compare"
      },
      {
        "command": "batchCompare.gitCompare",
        "title": "Batch Compare: Git History"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "batchCompare.compareFiles",
          "when": "!explorerResourceIsFolder && resourceScheme == file",
          "group": "3_compare"
        },
        {
          "command": "batchCompare.compare",
          "when": "explorerResourceIsFolder",
          "group": "3_compare"
        },
        {
          "command": "batchCompare.gitCompare",
          "when": "explorerResourceIsFolder",
          "group": "3_compare"
        }
      ],
      "commandPalette": [
        {
          "command": "batchCompare.compare",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "BatchCompare",
      "properties": {
        "batchCompare.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".git",
            "node_modules"
          ],
          "description": "Files or folders to exclude from comparison. Supports glob wildcards: * (any run of characters within a path segment), ** (across segments), and ? (a single character). Patterns without a slash match by base name at any depth (e.g. *.log, node_modules); patterns with a slash match the path relative to the compared folder (e.g. build/*, dist/**)."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run compile && vsce package --allow-missing-repository --skip-license",
    "publish": "npm run compile && vsce publish --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "monaco-editor": "^0.57.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
